# Local development: copy to backend/.env.
# Docker Compose: use --env-file backend/.env, or set these in the root .env.
# All names are case-sensitive in Linux containers. Never commit real credentials.
APP_ENV=development
# Public production must use trusted_proxy. The proxy must strip then inject
# X-Authenticated-User and X-Auth-Proxy-Secret on the private upstream hop.
COPILOT_AUTH_MODE=development
AUTH_PROXY_SECRET=
# Required in production. Use a TLS Redis URL outside a private local network.
REDIS_URL=
GEMINI_API_KEY=
# A separate random token (at least 32 characters) is required to use the server key.
# Public browsers use BYOK. Only an authenticated proxy should inject X-Server-Key-Token.
SERVER_KEY_ACCESS_TOKEN=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TEXT_MODEL=gemini-3.8-flash
# Supported voices: Kore, Aoede, Leda, Zephyr, Puck, Charon, Fenrir, Orus
GEMINI_TTS_VOICE=Kore

# AI Reading Copilot keys are server-owned. They are never accepted from browsers.
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
QWEN_API_KEY=
# In production, prefer *_FILE pointing at mounted secret files instead of values above.
# DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key
# ZHIPU_API_KEY_FILE=/run/secrets/zhipu_api_key
# QWEN_API_KEY_FILE=/run/secrets/qwen_api_key
# AUTH_PROXY_SECRET_FILE=/run/secrets/auth_proxy_secret
DEEPSEEK_TEXT_MODEL=deepseek-flash
# GLM 5.3 Flash stays disabled until its production API contract is verified.
GLM_TEXT_MODEL=glm-5.3-flash
QWEN_TEXT_MODEL=qwen3.7-flash-2026-07-15
QWEN_API_REGION=cn
COPILOT_DEFAULT_MODEL=deepseek-flash
COPILOT_ENABLED_MODELS=deepseek-flash,qwen-3.7-flash
COPILOT_ENABLE_UNVERIFIED_GLM53=false
COPILOT_PROMPT_VERSION=2026-09-v1
LLM_TIMEOUT_SECONDS=180
LLM_QUEUE_TIMEOUT_SECONDS=5
LLM_RESPONSE_MAX_BYTES=1048576
DEEPSEEK_MAX_CONCURRENCY=3
ZHIPU_MAX_CONCURRENCY=3
QWEN_MAX_CONCURRENCY=3
COPILOT_USER_MINUTE_UNITS=20
COPILOT_USER_DAILY_UNITS=200
COPILOT_GLOBAL_DAILY_UNITS=10000

# Empty means same-origin only. Otherwise use comma-separated exact origins.
CORS_ORIGINS=
MIN_TEXT_LENGTH=1
MAX_TEXT_LENGTH=1000
TTS_TIMEOUT_SECONDS=30
QUEUE_TIMEOUT_SECONDS=5
EDGE_TTS_MAX_CONCURRENCY=3
GEMINI_MAX_CONCURRENCY=3
MAX_PENDING_REQUESTS=16
MAX_REQUEST_BODY_BYTES=16384
REQUEST_BODY_TIMEOUT_SECONDS=10
REQUESTS_PER_MINUTE=120
GLOBAL_REQUESTS_PER_MINUTE=600

# Audio is a disposable shared cache; oldest entries are evicted at quota/expiry.
CACHE_MAX_BYTES=536870912
CACHE_MAX_ENTRIES=1000
CACHE_TTL_SECONDS=604800
CACHE_MIN_FREE_BYTES=67108864
MAX_AUDIO_BYTES=16777216
MEMORY_CACHE_MAX_BYTES=33554432

# Persistent history/chat records are NOT automatically deleted at quota.
# New writes fail with 507 until capacity is freed or raised by an administrator.
DB_BUSY_TIMEOUT_SECONDS=0.5
DB_MAX_BYTES=134217728
HISTORY_MAX_RECORDS=10000
EXPLANATION_MAX_RECORDS=1000
