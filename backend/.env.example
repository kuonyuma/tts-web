# ==========================================
# Gemini API 密钥
# ==========================================
# 如果系统环境变量中已有 GOOGLE_GENERATIVE_AI_API_KEY 或 GEMINI_API_KEY，此处可留空
GEMINI_API_KEY=

# ==========================================
# TTS 模型配置
# ==========================================
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ==========================================
# 音色选择 (Voice)
# ==========================================
# Gemini TTS 官方提供 30 种音色预设，常见推荐：
# - Kore: 坚定/稳重女声（默认推荐）
# - Aoede: 清爽/轻柔女声
# - Leda: 年轻/活力女声
# - Zephyr: 明亮/清澈女声
# - Puck: 活泼/阳光男声
# - Fenrir: 激昂/热情男声
# - Charon: 沉稳/新闻播报男声
# - Orus: 庄重/磁性男声
GEMINI_TTS_VOICE=Kore

# 服务监听配置（可选）
HOST=127.0.0.1
PORT=8000
